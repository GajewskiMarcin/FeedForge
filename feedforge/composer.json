{
    "name": "feedforge/feedforge",
    "description": "Google Merchant Center integration via Merchant API - PrestaShop 8/9",
    "version": "2.0.2",
    "type": "prestashop-module",
    "license": "AFL-3.0",
    "authors": [
        {
            "name": "Feed Forge"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-bcmath": "*",
        "google/auth": "^1.40"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "FeedForge\\": "src/"
        },
        "classmap": [
            "feedforge.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "FeedForge\\Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "prepend-autoloader": false,
        "sort-packages": true,
        "platform": {
            "php": "8.1"
        }
    }
}
